{
  "name": "safety-comic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "motion:stills": "node scripts/render-motion.mjs --stills",
    "motion:render": "node scripts/render-motion.mjs",
    "test:motion": "node --test tests/motion-story.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:lesson": "node --test tests/lesson.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "motion:all-stills": "node scripts/render-motion.mjs --all-stills"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.100"
  }
}
